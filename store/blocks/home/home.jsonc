{
  "store.home": {
    "blocks": [
      // "responsive-layout.desktop#slider-desktop",
      // "responsive-layout.mobile#slider-mobile",
      "list-context.image-list#home",
      "flex-layout.row#script_rd",
      "flex-layout.row#deals",
      "flex-layout.row#shelf-timer",
      "flex-layout.row#cookie-script",
      "__fold__",
      "flex-layout.row#shelf-mais-vendidos",
      "responsive-layout.mobile#banners-mobile",
      "responsive-layout.desktop#categorias",
      "responsive-layout.desktop#carrossel-5l-8l",
      "responsive-layout.desktop#img-como-usar",
      "responsive-layout.mobile#img-como-usar",
      "flex-layout.row#linha-line",
      "responsive-layout.mobile#categorias",
      "flex-layout.row#linha-line",
      "rich-text#prateleira-maior-capacidade",
      "flex-layout.row#shelf2",
      "flex-layout.row#linha-line",
      "rich-text#prateleira-madu-nova",
      "flex-layout.row#shelf3",
      "flex-layout.row#linha-line",
      "responsive-layout.desktop#instagram",
      "responsive-layout.mobile#instagram",
      "flex-layout.row#titulo-blog-home"
    ]
  },
  //  ESPAÇADOR
  "flex-layout.row#linha-line": {
    "props": {
      "blockClass": "linha-line",
      "fullWidth": false
    },
    "children": [
      "rich-text#line"
    ]
  },
  // TESTE
  "flex-layout.row#cookie-script": {
    "props": {
      "blockClass": "cookie-script"
    },
    "children": [
      "sandbox#cookie-script"
    ]
  },
  "sandbox#cookie-script": {
    "props": {
      "initialContent": "<script type='text/javascript' charset='UPeadfa3f040b66.js'></script>",
      "allowCookies": true
    }
  },
  // LIST CONTEXT DO SLIDER HOME
  "list-context.image-list#home": {
    "children": [
      "slider-layout#demo-images"
    ],
    "props": {
      "height": 570,
      "preload": true,
      "images": [
        {
          "image": "assets/home-black/banners/black-idealovers-kit-desktop.webp",
          "mobileImage": "assets/home-black/banners/black-idealovers-mobile.webp"
        },
        {
          "image": "assets/home-black/banners/opta-desktop.webp",
          "mobileImage": "assets/home-black/banners/opta-mobile.webp"
        }
      ]
    }
  },
  "slider-layout#demo-images": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "blockClass": "carousel",
      "autoplay": {
        "timeout": 8000,
        "stopOnHover": true
      }
    }
  },
  "responsive-layout.mobile#banners-mobile": {
    "children": [
      "rich-text#titulo-prateleira-5l",
      "flex-layout.row#shelf"
    ]
  },
  "responsive-layout.desktop#carrossel-5l-8l": {
    "children": [
      "flex-layout.row#linha-line",
      "rich-text#titulo-prateleira-5l",
      "flex-layout.row#shelf",
      "flex-layout.row#linha-line"
    ]
  },
  "flex-layout.row#script_rd": {
    "props": {
      "blockClass": "script_rd"
    },
    "children": [
      "scriptrd" // script do RD
    ]
  },
  // SECAO SHELF MAIS VENDIDOS - SOL. MARCOS CHICORA 05/09
  "flex-layout.row#shelf-mais-vendidos": {
    "props": {
      "blockClass": "shelf-mais-vendidos",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.row#linha-line",
      "rich-text#titulo-prateleira-mais-vendidos",
      "list-context.product-list#prateleira-mais-vendidos",
      "flex-layout.row#linha-line"
    ]
  },
  // LINHA SEPARADORA COM EFEITO
  "rich-text#line": {
    "props": {
      "text": "",
      "blockClass": "line"
    }
  },
  "rich-text#titulo-prateleira-mais-vendidos": {
    "props": {
      "text": "## Lançamentos",
      "blockClass": "shelfTitle"
    }
  },
  "list-context.product-list#prateleira-mais-vendidos": {
    "blocks": [
      "product-summary.shelf"
    ],
    "children": [
      "slider-layout#prateleira-mais-vendidos"
    ],
    "props": {
      "orderBy": "OrderByTopSaleDESC",
      "maxItems": 12
    }
  },
  "product-summary.shelf": {
    "props": {
      "priceBehavior": "default"
    }
  },
  "slider-layout#prateleira-mais-vendidos": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "blockClass": "shelf",
      "showNavigationArrows": "always"
    }
  },
  // SESSÃO DESKTOP - IMAGENS COMO USAR
  "responsive-layout.desktop#img-como-usar": {
    "children": [
      "flex-layout.row#linha-line",
      "flex-layout.row#linha-imgs-como-usar"
    ]
  },
  "flex-layout.row#linha-imgs-como-usar": {
    "props": {
      "blockClass": "linha-img-como-usar",
      "colSizing": "auto"
    },
    "children": [
      "image#loira",
      "image#rosa",
      "image#dvm"
    ]
  },
  // imagens linha como usar
  "image#loira": {
    "props": {
      "blockClass": "imagens-como-usar",
      "alt": "Mulher com autoclave",
      "src": "assets/linha-como-usar/loira-desktop.webp"
    }
  },
  "image#rosa": {
    "props": {
      "blockClass": "imagens-como-usar",
      "alt": "Match perfeito",
      "src": "assets/linha-como-usar/match-desktop.webp"
    }
  },
  "image#dvm": {
    "props": {
      "blockClass": "imagens-como-usar",
      "alt": "Tecnologia DVM",
      "src": "assets/linha-como-usar/dvm-desktop.webp",
      "link": {
        "url": "/tecnologia-dvm",
        "openNewTab": false
      }
    }
  },
  // SESSÃO DESKTOP - IMAGENS COMO USAR
  "responsive-layout.mobile#img-como-usar": {
    "children": [
      "flex-layout.row#linha-line",
      "flex-layout.row#linha-imgs-como-usar-mobile"
    ]
  },
  "flex-layout.row#linha-imgs-como-usar-mobile": {
    "props": {
      "blockClass": "linha-imgs-como-usar-mobile",
      "colSizing": "auto"
    },
    "children": [
      "list-context.image-list#imgs-como-usar-mobile"
    ]
  },
  // list context do componente com as imagens - slides MOBILE
  "list-context.image-list#imgs-como-usar-mobile": {
    "children": [
      "slider-layout#imgs-como-usar-mobile"
    ],
    "props": {
      "height": 620,
      "images": [
        {
          "mobileImage": "assets/linha-como-usar/loira-desktop.webp",
          "link": {
            "url": "/autoclave-bellinha-pronta-entrega",
            "openNewTab": false
          }
        },
        {
          "mobileImage": "assets/linha-como-usar/match-desktop.webp",
          "link": {
            "url": "/kits-autoclaves-idealine",
            "openNewTab": false
          }
        },
        {
          "mobileImage": "assets/linha-como-usar/dvm-desktop.webp",
          "link": {
            "url": "/tecnologia-dvm",
            "openNewTab": false
          }
        }
      ]
    }
  },
  // slider
  "slider-layout#imgs-como-usar-mobile": {
    "props": {
      "title": "Slider Imanges",
      "blockClass": "slider-imgs-como-usar",
      "itemsPerPage": {
        "phone": 2
      },
      "arrowSize": 15,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "autoplay": {
        "timeout": 8000,
        "stopOnHover": true
      }
    }
  },
  "rich-text#titulo-prateleira-5l": {
    "props": {
      "text": "## Autoclaves de 5 litros",
      "blockClass": "shelfTitle"
    }
  },
  // prateleira de 8 litros
  "flex-layout.row#shelf": {
    "children": [
      "list-context.product-list#prateleira-8litros"
    ]
  },
  "list-context.product-list#prateleira-8litros": {
    "blocks": [
      // "product-summary.shelf"
      "product-summary.shelf"
    ],
    "children": [
      "slider-layout#prateleira-8litros"
    ],
    "props": {
      "collection": "210",
      "orderBy": "OrderByReleaseDateDESC",
      "maxItems": 12
    },
    "title": "Prateleira 5 e 8 litros"
  },
  "slider-layout#prateleira-8litros": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "fullWidth": true,
      "blockClass": "shelf",
      "showNavigationArrows": "always"
    }
  },
  "flex-layout.row#shelf2": {
    "children": [
      "list-context.product-list#prateleira-maior-capacidade"
    ]
  },
  // linha da prateleira de maior capacidade
  "rich-text#prateleira-maior-capacidade": {
    "props": {
      "text": "## Autoclaves Horizontais",
      "blockClass": "shelfTitle"
    }
  },
  "list-context.product-list#prateleira-maior-capacidade": {
    "blocks": [
      "product-summary.shelf"
    ],
    "children": [
      "slider-layout#prateleira-maior-capacidade"
    ],
    "props": {
      "orderBy": "OrderByPriceASC",
      "collection": "208",
      "maxItems": 12
    }
  },
  "slider-layout#prateleira-maior-capacidade": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "blockClass": "shelf",
      "showNavigationArrows": "always"
    }
  },
  "flex-layout.row#shelf3": {
    "children": [
      "list-context.product-list#prateleira-madu"
    ]
  },
  // linha da prateleira de maior capacidade
  "rich-text#prateleira-madu-nova": {
    "props": {
      "text": "## Idea.Love by MAD.U",
      "blockClass": "shelfTitle"
    }
  },
  "list-context.product-list#prateleira-madu": {
    "blocks": [
      "product-summary.shelf"
    ],
    "children": [
      "slider-layout#prateleira-madu"
    ],
    "props": {
      "blockClass": "shelf",
      "orderBy": "OrderByBestDiscountDESC",
      "category": "80"
    }
  },
  "slider-layout#prateleira-madu": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "fullWidth": true,
      "blockClass": "shelf",
      "showNavigationArrows": "always"
    }
  },
  // BLOGO
  "flex-layout.row#titulo-blog-home": {
    "props": {
      "blockClass": "linha-blog"
    },
    "children": [
      "homepostsidealine"
    ]
  },
   "homepostsidealine": {
    "props": {
      "title": "Blog Idealine",
      "maxItems": 3,
      "autoPlayMs": 4500
    }
  }

}
