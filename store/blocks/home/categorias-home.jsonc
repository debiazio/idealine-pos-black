  // ===================================
  //SECAO COMPRE POR CATEGORIA - DESKTOP
  // ===================================
  "responsive-layout.desktop#categorias": {
    "children": [
      "disclosurecategorias",
      "flex-layout.row#compre-por-categoria"
    ]
  },
  "flex-layout.row#compre-por-categoria": {
    "props": {
      "blockClass": "container-compre-por-categoria",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#titulo-categorias-linha1",
      "flex-layout.row#categorias-disclosure"
      // "flex-layout.row#imagens-categorias",
      // "flex-layout.row#imagens-segunda-linha-categorias"
    ]
  },
  //conteiner do titulo das categorias
  "flex-layout.row#titulo-categorias-linha1": {
    "props": {
      "blockClass": "conteiner-titulo-categorias"
    },
    "children": [
      "rich-text#titulo"
    ]
  },
  //titulo das categorias
  "rich-text#titulo": {
    "props": {
      "text": "Categorias",
      "blockClass": "texto-titulo-categoria"
    }
  },
  // ================================
  // categorias -disclosures desktop
  // ================================
  "flex-layout.row#categorias-disclosure": {
    "props": {
      "blockClass": "linha-disclosure-categorias-desktop",
      "colSizing": "auto"
    },
    "children": [
      "disclosure-layout-group#group-categorias-desktop"
    ]
  },
  // =================================
  // categorias desktop
  // ================================
