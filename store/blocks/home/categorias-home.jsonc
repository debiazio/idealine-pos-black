{
  //SECAO COMPRE POR CATEGORIA - MOBILE
  "responsive-layout.mobile#categorias": {
    "children": [
      // "disclosurecategorias",
      "flex-layout.row#titulo-categorias-linha1",
      "flex-layout.row#categorias-disclosure-mobile"
    ]
  },
  // ================================
  // categorias -disclosures mobile
  // ================================
  "flex-layout.row#categorias-disclosure-mobile": {
    "props": {
      "blockClass": "linha-disclosure-categorias-mobile"
    },
    "children": [
      "flex-layout.col#disclosure-mobile1",
      "flex-layout.col#disclosure-mobile2"
    ]
  },
  // COLUNA 1 MOBILE
  "flex-layout.col#disclosure-mobile1": {
    "props": {
      "blockClass": "colunas-disclosure-mobile"
    },
    "children": [
      "disclosure-layout-group#group-categorias-mobile1"
    ]
  },
  // COLUNA 2 MOBILE
  "flex-layout.col#disclosure-mobile2": {
    "props": {
      "blockClass": "colunas-disclosure-mobile"
    },
    "children": [
      "disclosure-layout-group#group-categorias-mobile2"
    ]
  },
  // =================================
  // categorias mobile
  // ================================
  "disclosure-layout-group#group-categorias-mobile1": {
    "props": {
      "maxVisible": "one",
      "blockClass": "disclosure-group-mobile"
    },
    "children": [
      "disclosure-layout#nails-manicure-mobile",
      "disclosure-layout#odontologia-mobile",
      "disclosure-layout#body-mobile",
      "disclosure-layout#laboratorio-mobile"
    ]
  },
  "disclosure-layout-group#group-categorias-mobile2": {
    "props": {
      "maxVisible": "one",
      "blockClass": "disclosure-group-mobile"
    },
    "children": [
      "disclosure-layout#veterinaria-mobile",
      "disclosure-layout#podologia-mobile",
      "disclosure-layout#lash-mobile",
      "disclosure-layout#clinicas-mobile"
    ]
  },
  // =================================
  // categorias mobile - nails e manicure
  // ================================
  "disclosure-layout#nails-manicure-mobile": {
    "props": {
      "initialVisibility": "visible"
    },
    "children": [
      "disclosure-trigger#nails-manicure-mobile",
      "disclosure-content#nails-manicure-mobile"
    ]
  },
  // categorias mobile - trigger nails e manicure
  "disclosure-trigger#nails-manicure-mobile": {
    "props": {
      "blockClass": "categoria-trigger-mobile"
    },
    "children": [
      "rich-text#gatilho-nails-manicure-mobile"
    ]
  },
  // categorias mobile - texto gatilho nails e manicure
  "rich-text#gatilho-nails-manicure-mobile": {
    "props": {
      "blockClass": "texto-gatilho-categoria-mobile",
      "text": "nails / manicure"
    }
  },
  // categorias mobile - conteudo imagem nails e manicure
  "disclosure-content#nails-manicure-mobile": {
    "props": {
      "blockClass": "conteudo-imagem-categoria",
      "open": true
    },
    "children": [
      "image#nails-manicure-img-cat-mobile"
    ]
  },
  // categorias mobile  - imagem nails e manicure
  "image#nails-manicure-img-cat-mobile": {
    "props": {
      "blockClass": "imagem-categoria-mobile",
      "src": "assets/categorias/nail.webp",
      "link": {
        "url": "/beleza-e-estetica/autoclaves-para-manicure"
      }
    }
  },
  // =================================
  // categorias mobile - odontologia
  // ================================
  "disclosure-layout#odontologia-mobile": {
    "props": {
      "initialVisibility": "hidden"
    },
    "children": [
      "disclosure-trigger#odontologia-mobile",
      "disclosure-content#odontologia-mobile"
    ]
  },
  // categorias mobile - gatilho odontologia
  "disclosure-trigger#odontologia-mobile": {
    "props": {
      "blockClass": "categoria-trigger-mobile"
    },
    "children": [
      "rich-text#odontologia-gatilho-mobile"
    ]
  },
  // categorias mobile - texto gatilho odontologia
  "rich-text#odontologia-gatilho-mobile": {
    "props": {
      "blockClass": "texto-gatilho-categoria-mobile",
      "text": "Odontologia"
    }
  },
  // categorias mobile - conteudo imagem
  "disclosure-content#odontologia-mobile": {
    "props": {
      "blockClass": "conteudo-imagem-categoria"
    },
    "children": [
      "image#odontologia-img-cat-mobile"
    ]
  },
  // categorias mobile - imagem
  "image#odontologia-img-cat-mobile": {
    "props": {
      "blockClass": "imagem-categoria-mobile",
      "src": "assets/categorias/odonto.webp",
      "link": {
        "url": "/odontologia/autoclaves-para-odontologia"
      }
    }
  },
  // =================================
  // categorias mobile - body
  // ================================
  "disclosure-layout#body-mobile": {
    "props": {
      "initialVisibility": "hidden"
    },
