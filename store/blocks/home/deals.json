    "props": {
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/5a0eb7b2-fcb4-4b7c-8978-9892b92f801a___f6e7080892fddbac5d75fea5e424a608.png",
      "blockClass": "img-deals"
    }
  },
  "rich-text#parcelas": {
    "props": {
      "text": "**PARCELE\n EM ATÉ 10X**",
      "blockClass": "deals"
    }
  },
  "rich-text#subtitulo-parcelas-6x":{
    "props": {
      "text": "Com a gente você pode parcelar em ate 10x sem juros no cartão de crédito",
      "blockClass": "sub-mobile-deals"
    }
  },
