{
  "flex-layout.row#deals": {
    "children": [
      "flex-layout.col#deals1",
      "flex-layout.col#deals2",
      "flex-layout.col#parcelamento",
      "flex-layout.col#deals4",
      "flex-layout.col#deals5"
    ],
    "props": {
      "blockClass": ["deals", "mobile-deals"]
    }
  },

  "flex-layout.col#deals1": {
    "props": {
      "blockClass": "coluna-deals",
      "colSizing": "auto"
    },
    "children": [
      "image#deal1",
      "rich-text#deal1",
      "rich-text#sub-deal1"
    ]
  },
  "image#deal1": {
    "props": {
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/e66fef70-b11f-47e4-85c5-a80c5cf277de___b6bc751dfea123e7aae8edb9b1ecb1c1.png",
      "blockClass": "img-deals"
    }
  },
  "rich-text#deal1": {
    "props": {
      "text": "**ENTREGAS PARA\n TODO O BRASIL**",
      "blockClass": "deals"
    }
  },
  "rich-text#sub-deal1":{
    "props": {
      "text": "Nós entregamos onde for melhor para você e o seu negócio",
      "blockClass": "sub-mobile-deals"
    }
  },

  "flex-layout.col#deals2": {
    "props": {
      "blockClass": "coluna-deals",
      "colSizing": "auto"
    },
    "children": [
      "image#deal2",
      "rich-text#deal2",
      "rich-text#sub-deal2"
    ]
  },
  "image#deal2": {
    "props": {
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/46fe11da-e6fe-44c0-bb03-72836a198ba3___2cd23fa129bbacc39d13e73cbd273398.png",
      "blockClass": "img-deals"
    }
  },
  "rich-text#deal2": {
    "props": {
      "text": "**GARANTIA\n DE FÁBRICA**",
      "blockClass": "deals"
    }
  },
  "rich-text#sub-deal2":{
    "props": {
      "text": "Garantia de 12 meses oferecida pelo fabricante",
      "blockClass": "sub-mobile-deals"
    }
  },
  "flex-layout.col#parcelamento": {
    "props": {
      "blockClass": "coluna-deals",
      "colSizing": "auto"
    },
    "children": [
