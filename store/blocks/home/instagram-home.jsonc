{
  "responsive-layout.desktop#instagram": {
    "children": [
      "flex-layout.row#conteiner-instagram-desktop",
      "flex-layout.row#linha-line"
    ]
  },
  "responsive-layout.mobile#instagram": {
    "children": [
      "flex-layout.row#conteiner-instagram-desktop"
    ]
  },
  // LINHA INSTAGRAM - DESKTOP
  "flex-layout.row#conteiner-instagram-desktop": {
    "props": {
      "blockClass": "conteiner-instagram-desktop",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.row#titulo-instagram",
      "flex-layout.row#conteiner-imagens-instagram-desktop"

    ]
  },
  // LINHA DO TITULO
  "flex-layout.row#titulo-instagram": {
    "props": {
      "blockClass": "linha-instagram"
    },
    "children": [
      "rich-text#titulo-instagram"
    ]
  },
  "rich-text#titulo-instagram": {
    "props": {
      "text": "## Redes sociais ##",
      "blockClass": "shelfTitle"
    }
  },
  // LINHA DAS IMAGENS
  "flex-layout.row#conteiner-imagens-instagram-desktop": {
    "props": {
      "blockClass": "conteiner-imgs-instagram-desktop",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.col#coluna1-instagram-desktop",
      "flex-layout.col#coluna2-instagram-desktop",
      "flex-layout.col#coluna3-instagram-desktop"
    ]
  },
  // COLUNAS INSTAGRAM DESKTOP
  "flex-layout.col#coluna1-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-1"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna1",
      "flex-layout.row#linha-img-inferior-coluna1"
    ]
  },
  "flex-layout.col#coluna2-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-2"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna2",
      "flex-layout.row#linha-img-inferior-coluna2"
    ]
  },
  "flex-layout.col#coluna3-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-3"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna3",
      "flex-layout.row#linha-img-inferior-coluna3"
    ]
  },
  // BLOCO DAS COLUNAS
  // LINHAS DA COLUNA 1
  "flex-layout.row#linha-img-superior-coluna1": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna1-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna1": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna1-instagram",
      "image#instagram-rodape"
    ]
  },
  // LINHAS DA COLUNA 2
  "flex-layout.row#linha-img-superior-coluna2": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna2-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna2": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna2-instagram",
      "image#instagram-rodape"
    ]
  },
  // LINHAS DA COLUNA 3
  "flex-layout.row#linha-img-superior-coluna3": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna3-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna3": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna3-instagram",
      "image#instagram-rodape"
    ]
  },
  // FIM BLOCO DAS COLUNAS
  // BLOCO DAS IMAGENS
  "image#postagem1-coluna1-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/863ad46f-5516-4738-95c8-592d1be5d6a0___902eaefa8ca853d88759bb32150f3199.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfXK9hbgcqH/",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna1-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/00b3222c-8163-40e6-ad2f-4ba2431ae8e1___5c29d55d7e1f5bbf12167fd08bef3ce1.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfX91WfOloE/",
        "openNewTab": true
      }
    }
  },
  "image#postagem1-coluna2-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/e90a3644-78fb-4aac-9b97-7153b7bd0b97___d018c5934411b79bbe36a53d673c7f12.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfXBELIgYzi/",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna2-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/2803929b-5f46-4d69-a116-1e60cfb061a1___4e06dbb6a94a816a540a487d6ec1fc58.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfVVk1qOoUa/",
        "openNewTab": true
      }
    }
  },
  "image#postagem1-coluna3-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/ea4eda61-df40-459a-b850-223a3f8d36cb___c0a07a63560fa84fa87420f220d811ec.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfUgz7PA1qe/",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna3-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/977bb3d4-7cae-48e0-abbc-7123214ee2fe___f889d75e3e980b5325dc1d97abdc603f.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DfS0z28OhPj/",
        "openNewTab": true
      }
    }
  },
  // FIM BLOCO DAS IMAGENS
  "image#instagram-rodape": {
    "props": {
      "blockClass": "instagram-rodape",
      "src": "assets/instagram-home/instagram-rodape.webp",
      "alt": "Rodapé Instagram"
    }
  }
}
