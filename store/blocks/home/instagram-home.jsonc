{
  "responsive-layout.desktop#instagram": {
    "children": [
      "flex-layout.row#conteiner-instagram-desktop"
    ]
  },
  "responsive-layout.mobile#instagram": {
    "children": [
      "flex-layout.row#conteiner-instagram-desktop"
    ]
  },
  // LINHA INSTAGRAM - DESKTOP
  "flex-layout.row#conteiner-instagram-desktop": {
    "props": {
      "blockClass": "conteiner-instagram-desktop",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.row#titulo-instagram",
      "flex-layout.row#conteiner-imagens-instagram-desktop"
    ]
  },
  // LINHA DO TITULO
  "flex-layout.row#titulo-instagram": {
    "props": {
      "blockClass": "linha-instagram"
    },
    "children": [
      "rich-text#titulo-instagram"
    ]
  },
  "rich-text#titulo-instagram": {
    "props": {
      "text": "## Redes sociais ##",
      "blockClass": "shelfTitle"
    }
  },
  // LINHA DAS IMAGENS
  "flex-layout.row#conteiner-imagens-instagram-desktop": {
    "props": {
      "blockClass": "conteiner-imgs-instagram-desktop",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.col#coluna1-instagram-desktop",
      "flex-layout.col#coluna2-instagram-desktop",
      "flex-layout.col#coluna3-instagram-desktop"
    ]
  },
  // COLUNAS INSTAGRAM DESKTOP
  "flex-layout.col#coluna1-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-1"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna1",
      "flex-layout.row#linha-img-inferior-coluna1"
    ]
  },
  "flex-layout.col#coluna2-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-2"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna2",
      "flex-layout.row#linha-img-inferior-coluna2"
    ]
  },
  "flex-layout.col#coluna3-instagram-desktop": {
    "props": {
      "blockClass": [
        "colunas-instagram-desktop",
        "insta-col-3"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-img-superior-coluna3",
      "flex-layout.row#linha-img-inferior-coluna3"
    ]
  },
  // BLOCO DAS COLUNAS
  // LINHAS DA COLUNA 1
  "flex-layout.row#linha-img-superior-coluna1": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna1-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna1": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna1-instagram",
      "image#instagram-rodape"
    ]
  },
  // LINHAS DA COLUNA 2
  "flex-layout.row#linha-img-superior-coluna2": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna2-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna2": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna2-instagram",
      "image#instagram-rodape"
    ]
  },
  // LINHAS DA COLUNA 3
  "flex-layout.row#linha-img-superior-coluna3": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem1-coluna3-instagram",
      "image#instagram-rodape"
    ]
  },
  "flex-layout.row#linha-img-inferior-coluna3": {
    "props": {
      "blockClass": "linha-img-colunas",
      "colSizing": "auto"
    },
    "children": [
      "image#postagem2-coluna3-instagram",
      "image#instagram-rodape"
    ]
  },
  // FIM BLOCO DAS COLUNAS
  // BLOCO DAS IMAGENS
  "image#postagem1-coluna1-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/d4ee7df6-94a4-4423-ba1d-15aac18291dc___d2746db9f44fa24be4cc0cb16630ad42.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DeuxEGav0Da/",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna1-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/c6a3404d-bbff-425b-bd49-e3a3e34cec9c___6a27d39d183b2385bc886a898dcceb94.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DeuM9EWASzp/",
        "openNewTab": true
      }
    }
  },
  "image#postagem1-coluna2-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/a5423e61-75e8-414c-bda8-790947b1eb73___f89a55c67fedf34f19e7dff2b7ce9414.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/Detu301FT-9/?img_index=1",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna2-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/5ea4c4ed-d47f-4760-b2af-13356a346f49___5205d6d716f16c429c500264f3ebac9c.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/Derz7E6sBky/",
        "openNewTab": true
      }
    }
  },
  "image#postagem1-coluna3-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/00f81a39-d4a4-446e-9406-366cb0a2ea5b___6231bccd0a2945e547f163e961f60cea.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DerQPfnAfQR/",
        "openNewTab": true
      }
    }
  },
  "image#postagem2-coluna3-instagram": {
    "props": {
      "blockClass": "img-instagram",
      "src": "https://mfmgroup.vtexassets.com/assets/vtex.file-manager-graphql/images/62f7ca55-ae11-4b2a-9a9d-feafc2a3501f___9c336086169d0b1e089b8929236dd043.webp",
      "alt": "Postagem Instagram Idealine",
      "link": {
        "url": "https://www.instagram.com/p/DekXqWgvHG_/",
        "openNewTab": true
      }
    }
  },
  // FIM BLOCO DAS IMAGENS
  "image#instagram-rodape": {
    "props": {
      "blockClass": "instagram-rodape",
      "src": "assets/instagram-home/instagram-rodape.webp",
      "alt": "Rodapé Instagram"
    }
  }
}
