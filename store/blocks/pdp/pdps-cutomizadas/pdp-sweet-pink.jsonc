{
  "condition-layout.product#visualizador3d-sweet-pink": {
    "props": {
      "conditions": [
        {
          "subject": "productId",
          "arguments": {
            "id": "2945" //sweet pink
          }
        }
      ],
      "Then": "flex-layout.row#visualizador-360" 
    }
  },
  "flex-layout.row#visualizador-360": {
    "props": {
      "blockClass": "conteiner-360"
    },
    "children": [
      "flex-layout.row#linha360textos",
      "flex-layout.row#linha360imgs-sweetpink"
    ]
  },
  "flex-layout.row#linha360imgs-sweetpink": {
    "props": {
      "blockClass": "linha360imgs"
    },
    "children": [
      "image#icone360",
      "vr-sweet-pink"
    ]
  },
  "image#icone360": {
    "props": {
      "blockClass": "icone360",
      "src": "assets/360-degrees.svg",
      "alt": "Ícone 360°"
    }
  }
}
