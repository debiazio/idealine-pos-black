{
  "condition-layout.product#visualizador3d-dr-marcelo": {
    "props": {
      "conditions": [
        {
          "subject": "productId",
          "arguments": {
            "id": "2798" //DR MARCELO
          }
        }
      ],
      "Then": "flex-layout.row#visualizador-360-dr-marcelo"
    }
  },
  "flex-layout.row#visualizador-360-dr-marcelo": {
    "props": {
      "blockClass": "conteiner-360"
    },
    "children": [
      "flex-layout.row#linha360textos",
      "flex-layout.row#linha360imgs-dr-marcelo"
    ]
  },
  "flex-layout.row#linha360imgs-dr-marcelo": {
    "props": {
      "blockClass": "linha360imgs"
    },
    "children": [
      "image#icone360",
      "vr-dr-marcelo"
    ]
  }
}
