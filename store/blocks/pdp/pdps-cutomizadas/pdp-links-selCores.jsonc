{
  // SELETOR DE PRODUTOS PDP
  "flex-layout.row#product-din-selector-produtos": {
    "props": {
      "blockClass": "product-selecor-prod-din",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "link.product#bellinha-rosa",
      "link.product#bellinha-rose-gold",
      "link.product#bellinha-perola",
      "link.product#bellinha-sweet-pink",
      "link.product#bellinha-sweet-black",
      // "link.product#marcelo-brito",
      "link.product#sweet-silver",
      "link.product#lilac",
      "appalterafundo"
    ]
  },
  // bolinha rosa
  "link.product#bellinha-rosa": {
    "props": {
      "blockClass": [
        "label-botao",
        "link-bell-rosa"
      ],
      "href": "/autoclave-idealclave-bellinha-com-tecnologia-dvm-rosa/p/",
      "rel": "_blank"
    },
    "children": [
      "image#rosa-miniatura"
    ]
  },
  "image#rosa-miniatura": {
    "props": {
      "blockClass": [
        "miniaturas",
        "rosa-miniatura"
      ],
      "src": "assets/nova-pdp/miniaturas/rosa-miniatura.png"
    }
  },
  // bolinha rose gold
  "link.product#bellinha-rose-gold": {
    "props": {
      "blockClass": [
        "label-botao",
