{
  "product-summary.shelf": {
    "children": [
      // "condition-layout.product#selo-promocao-dia-consumidor", //para lembrar que isso pode ser feito
      "showifcollection",
      "stack-layout#prodsum",
      "product-summary-name", //nome
      "flex-layout.col#productRating", //avaliações
      // "product-summary-space",
      "flex-layout.row#linha-prateleira"
    ]
  },
  "condition-layout.product#selo-promocao-dia-consumidor":{
    "props": {
      "conditions": [
        {
          "subject": "productClusters",
          "arguments": {
            "id": "220"
          }
        }
      ],
      "Then": "image#selo-promocao"
    }
  },
  "image#selo-promocao":{
    "props": {
      "blockClass": "selo-promocao",
      "src": "assets/mes-consumidor/LOGO 200X200 2.png",
      "alt": "Selo dia consumidor"
    }
  },

  "flex-layout.row#linha-prateleira": {
    "props": {
      "blockClass": "linha-prateleira-duas-colunas"
    },
    "children": [
      "flex-layout.col#coluna1-parcelamento"
      // "flex-layout.col#coluna2-parcelamento"
    ]
  },
  "flex-layout.col#coluna1-parcelamento": {
    "props": {
      "blockClass": "coluna-parcelamento"
    },
    "children": [
      "product-list-price#summary", //preco de: quanto custav
      "product-selling-price", //preço padrão //removido para aplicar o custom dos 10%
      // "aplicapromo",
      "rich-text#pixouavista",
      "flex-layout.row#linhaparcelas-texto-sem-juros"

      // "product-installments#summary-segunda-linha"
      // "bundle",
      // "product-spot-price-savings"//removido para teste gif
    ]
  },
  "flex-layout.row#linhaparcelas-texto-sem-juros":{
    "props": {
      "blockClass": "linhaparcelas-texto-sem-juros",
      "colSizing": "auto"
    },
    "children": [
      "product-installments#summary-teste", // parcelamento
      "rich-text#texto-semjuros"
    ]
  },
  "rich-text#texto-semjuros":{
    "props": {
      "blockClass": "textosemjuros",
      "text": "SEM JUROS"
    }
  },
  "rich-text#pixouavista":{
    "props": {
      "blockClass": "nopixouavista",
      "text": "No pix ou à vista"
    }
  },
  "flex-layout.col#coluna2-parcelamento": {
    "props": {
      "blockClass": "coluna-parcelamento",
      "width": "20%"
    },
    "children": [
      "product-price-savings#summary-shelf"
    ]
  },
  "product-price-savings#summary-shelf": {
    "props": {
      "markers": [
        "discount"
      ],
      "message": "-{savingsPercentage}",
      "blockClass": "desconto"
    }
  },
  "flex-layout.col#productRating": {
    "props": {
      "blockClass": "productRating",
      "preventVerticalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "product-rating-inline"
    ]
  },
  "stack-layout#prodsum": {
    "children": [
      "add-to-list-btn", //fav button
      "product-summary-image#shelf",
      "flex-layout.row#sacola-icone"
    ]
  },
  "product-summary-image#shelf": {
    "props": {
      "aspectRatio": "1:1",
      "maxHeight": "auto",
      "blockclass": "imagens-shelf",
      "showBadge": false,
      "badgeText": "de desconto",
      "mainImageLabel": {
        "label": "principal",
        "labelMatchCriteria": "exact"
      },
      "hoverImage": {
        "criteria": "label",
        "label": "hover",
        "labelMatchCriteria": "exact"
      }
      // "width": {
      //   "desktop": "280",
      //   "mobile": "157"
      // },
      // "height": {
      //   "desktop": "280",
      //   "mobile": "157"
      // }
    }
  },
  "vtex.product-highlights@2.x:product-highlights#collection": {
    "props": {
      "type": "promotion"
    },
    "children": [
      "product-highlight-wrapper"
    ]
  },
  "product-highlight-wrapper": {
    "props": {
      "blockClass": "collection"
    },
    "children": [
      "product-highlight-text"
    ]
  },
  "product-highlight-text": {
    "props": {
      "message": "{highlightName}"
    }
  },
  "product-list-price#summary": {
    "props": {
      "blockClass": "summary",
      "message": "{ listPriceValue}"
    }
  },
  "product-spot-price-savings": {
    "props": {
      "blockClass": "summary",
      "message": "À VISTA GANHE 3% DE DESCONTO"
      // "message": "OU {newSpotPriceValue} À VISTA  NO BOLETO (3% DE DESCONTO)"
    }
  },
  "product-installments#summary-teste": {
    "props": {
      "blockClass": "summary",
      "message": "{hasMoreThanOne, select, true { ou {installmentsNumber}x de {installmentValue}}  false { }}"
    }
  },
  "product-installments#summary-segunda-linha": {
    "props": {
      "blockClass": "summary-segunda",
      "message": "{hasMoreThanOne, select, true { ou } false { }}",
      "installmentsCriteria": "max-quantity"
    }
  },
  //linha adicionada para teste ICONE SACOLA - botao comprar
  "flex-layout.row#sacola-icone": {
    "props": {
      "blockClass": "sacola-icone"
    },
    "children": [
      "add-to-cart-button#sacola-icon"
    ]
  },
  "add-to-cart-button#sacola-icon": {
    "props": {
      // "text": "teste",
      "blockClass": "botao-icone-sacola",
      "addToCartFeedback": "customEvent",
      "customPixelEventId": "add-to-cart-button",
      "unavailableText": "Produto indisponível"
    }
  },
  "product-selling-price#summary": {
    "props": {
      "blockClass": "summary",
      "message": "{sellingPriceValue}"
    }
  },
  "product-price-savings#summary": {
    "props": {
      "markers": [
        "discount"
      ],
      "blockClass": "summary",
      "message": "- {savingsValue}"
    }
  }
}
