{
  "store.custom#template-categoria": {
    "blocks": [
      "flex-layout.row#template-linha-1",
      "search-result-layout.customQuery#template-cat"
    ]
  },

  "flex-layout.row#template-linha-1": {
    "children": [
      "rich-text#titulo-template"
    ],
    "title": "Linha 1 - template"
  },

  "rich-text#titulo-template": {
    "props": {
      "text": "Título template",
      "blockClass": "titulo-template"
    },
    "title": "Título template"
  },

  "search-result-layout.customQuery#template-cat": {
    "props": {
      "querySchema": {
        "queryField": "208",
        "mapField": "productClusterIds",
        "orderByField": "OrderByTopSaleDESC",
        "hideUnavailableItems": true,
        "maxItemsPerPage": 12
      }
    },
    "blocks": [
      "search-result-layout.desktop#template",
      "search-result-layout.mobile#template",
      "search-not-found-layout#template"
    ]
  },

  "search-result-layout.desktop#template": {
    "children": [
      "order-by.v2",
      "flex-layout.row#results-template-cat"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-result-layout.mobile#template": {
    "children": [
      "order-by.v2",
      "flex-layout.row#results-template-cat"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-not-found-layout#template": {
    "children": [
      "not-found"
    ]
  },

  "flex-layout.row#results-template-cat": {
    "props": {
      "blockClass": "results-linha",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.col#filter-template",
      "flex-layout.col#search-template"
    ]
  },

  "flex-layout.col#filter-template": {
    "props": {
      "width": "20%",
      "blockClass": "coluna-filtros"
    },
    "children": [
      "filter-navigator.v3"
    ]
  },

  "flex-layout.col#search-template": {
    "props": {
      "width": "grow",
      "preventVerticalStretch": true
    },
    "children": [
      "search-content#template"
    ]
  },

  "search-content#template": {
    "blocks": [
      "gallery#template",
      "not-found"
    ]
  },

  "gallery#template": {
    "blocks": [
      "product-summary.shelf"
    ]
  }
}
