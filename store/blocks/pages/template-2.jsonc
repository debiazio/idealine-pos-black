{
  "store.custom#template-categoria-2": {
    "blocks": [
      "flex-layout.row#template-copy-linha-1",
      "search-result-layout.customQuery#template-copy-cat"
    ]
  },

  "flex-layout.row#template-copy-linha-1": {
    "props": {
      "blockClass": "template-copy-line",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "image#banner-template-copy",
      "rich-text#titulo-template-copy"
    ],
    "title": "Linha 1 - template-copy"
  },

  "image#banner-template-copy": {
    "props": {
      "blockClass": "banner-template",
      "src": "assets/banner_menu_idealine_beleza_e_estetica.webp",
      "alt": "Banner categoria"
    },
    "title": "Banner template"
  },

  "rich-text#titulo-template-copy": {
    "props": {
      "text": "# Título template #",
      "blockClass": "titulo-template"
    },
    "title": "Título template"
  },

  "search-result-layout.customQuery#template-copy-cat": {
    "props": {
      "querySchema": {
        "queryField": "208",
        "mapField": "productClusterIds",
        "orderByField": "OrderByTopSaleDESC",
        "hideUnavailableItems": true,
        "maxItemsPerPage": 12
      }
    },
    "blocks": [
      "search-result-layout.desktop#template-copy",
      "search-result-layout.mobile#template-copy",
      "search-not-found-layout#template-copy"
    ]
  },

  "search-result-layout.desktop#template-copy": {
    "children": [
      "order-by.v2",
      "flex-layout.row#results-template-copy-cat"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-result-layout.mobile#template-copy": {
    "children": [
      "order-by.v2",
      "flex-layout.row#results-template-copy-cat"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-not-found-layout#template-copy": {
    "children": [
      "not-found"
    ]
  },

  "flex-layout.row#results-template-copy-cat": {
    "props": {
      "blockClass": "template-copy-results",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.col#filter-template-copy",
      "flex-layout.col#search-template-copy"
    ]
  },

  "flex-layout.col#filter-template-copy": {
    "props": {
      "width": "20%"
    },
    "children": [
      "filter-navigator.v3"
    ]
  },

  "flex-layout.col#search-template-copy": {
    "props": {
      "width": "grow",
      "preventVerticalStretch": true
    },
    "children": [
      "search-content#template-copy"
    ]
  },

  "search-content#template-copy": {
    "blocks": [
      "gallery#template-copy",
      "not-found"
    ]
  },

  "gallery#template-copy": {
    "blocks": [
      "product-summary.shelf"
    ]
  }
}
